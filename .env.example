# Copia in .env (sviluppo locale). In produzione: variabili/segreti del Worker Cloudflare.
PUBLIC_SITE_URL=http://localhost:4321

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email dal Gmail di FRENZ (password per app, non la password normale). Alternativa: RESEND_API_KEY.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
# Uno o più indirizzi separati da virgola
ORDER_NOTIFICATION_EMAIL=

TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics: token del beacon (dashboard Cloudflare > Web Analytics). Senza cookie.
PUBLIC_CF_BEACON_TOKEN=

# Google Analytics 4 (G-XXXXXXXXXX). Con l'ID compare il banner cookie e GA parte solo dopo "Accetta".
# Va in .env.production, non qui: così `astro dev` non manda le prove locali nei dati di FRENZ.
PUBLIC_GA_MEASUREMENT_ID=
