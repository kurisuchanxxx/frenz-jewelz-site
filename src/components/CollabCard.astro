---
import SanityImage from './SanityImage.astro'
import type {Collaboration} from '../lib/types'

interface Props {
  collab: Pick<Collaboration, 'artistName' | 'slug' | 'portrait'>
}
const {collab} = Astro.props
---

<a href={`/collab#${collab.slug}`} class="collab">
  <SanityImage image={collab.portrait} aspect={3 / 4} sizes="(min-width: 640px) 40vw, 90vw" widths={[360, 540, 720, 960]} />
  <span class="collab__name">{collab.artistName}</span>
</a>

<style>
  .collab {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    background: var(--grey-900);
    overflow: hidden;
    text-decoration: none;
  }

  .collab :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: transform 0.7s var(--ease);
  }

  .collab:hover :global(img) {
    transform: scale(1.04);
  }

  .collab__name {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.4em 0.5em;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: center;
    color: var(--white);
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.6);
    background: linear-gradient(to top, rgb(0 0 0 / 0.7), transparent);
  }
</style>
