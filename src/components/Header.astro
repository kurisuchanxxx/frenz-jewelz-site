---
interface Props {
  announcement?: string
}
const {announcement} = Astro.props
const path = Astro.url.pathname

const NAV = [
  {href: '/shop', label: 'Shop'},
  {href: '/su-misura', label: 'Su misura'},
  {href: '/collab', label: 'Collab'},
  {href: '/about', label: 'About'},
]
const isActive = (href: string) => path === href || path.startsWith(`${href}/`)
---

{announcement && <div class="announcement">{announcement}</div>}
<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo" aria-label="Frenz Jewelz, home">
      <img src="/logo.webp" alt="" width="783" height="346" class="logo__img" fetchpriority="high" />
    </a>

    <nav class="nav" aria-label="Principale">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/shop" class="cart-link" aria-label="Carrello" data-cart-open>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.5 3.5h2.2l2.4 11.3a1.5 1.5 0 0 0 1.47 1.2h8.9a1.5 1.5 0 0 0 1.46-1.15L21 7.5H6.2"></path>
        <circle cx="9.5" cy="20" r="1.4"></circle>
        <circle cx="17.5" cy="20" r="1.4"></circle>
      </svg>
      <span class="cart-link__count" data-cart-count hidden></span>
    </a>
  </div>
</header>

<style>
  .announcement {
    background: var(--white);
    color: var(--black);
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.5em var(--gutter);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--grey-900);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .logo {
    text-decoration: none;
  }

  .logo__img {
    height: 44px;
    width: auto;
  }

  .nav ul {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--grey-300);
    transition: color 0.2s var(--ease);
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--white);
  }

  .cart-link {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }

  .cart-link__count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding-inline: 5px;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--black);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }

  @media (max-width: 640px) {
    .header__inner {
      grid-template-columns: 1fr auto;
      row-gap: 0;
      padding-block: 0.5rem;
    }

    .nav {
      grid-column: 1 / -1;
      grid-row: 2;
      overflow-x: auto;
    }

    .nav ul {
      justify-content: space-between;
      padding-block: 0.5rem;
    }
  }
</style>
