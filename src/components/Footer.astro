---
import {PUBLIC_GA_MEASUREMENT_ID} from 'astro:env/client'

interface Props {
  instagramUrl?: string
  facebookUrl?: string
  contactEmail?: string
  legalName?: string
  vatNumber?: string
  legalAddress?: string
}
const {instagramUrl, facebookUrl, contactEmail, legalName, vatNumber, legalAddress} = Astro.props
const year = new Date().getFullYear()

const INFO = [
  {href: '/spedizioni-resi', label: 'Spedizioni e resi'},
  {href: '/guida', label: 'Taglie e cura dell’argento'},
  {href: '/su-misura', label: 'Su misura'},
]
const LEGAL = [
  {href: '/termini', label: 'Termini e condizioni'},
  {href: '/privacy', label: 'Privacy policy'},
  {href: '/cookie', label: 'Cookie policy'},
]
---

<footer class="footer">
  <div class="container">
    <div class="footer__cols">
      <nav aria-label="Informazioni">
        <p class="eyebrow">Info</p>
        <ul>{INFO.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Note legali">
        <p class="eyebrow">Legale</p>
        <ul>
          {LEGAL.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          {/* Riapre il banner di ConsentBanner.astro: revocare deve essere facile quanto accettare. */}
          {PUBLIC_GA_MEASUREMENT_ID && <li><button type="button" class="footer__link" data-consent-open>Gestisci cookie</button></li>}
        </ul>
      </nav>
      <div>
        <p class="eyebrow">Contatti</p>
        <ul>
          {contactEmail && <li><a href={`mailto:${contactEmail}`}>{contactEmail}</a></li>}
          {instagramUrl && <li><a href={instagramUrl} rel="noopener" target="_blank">Instagram</a></li>}
          {facebookUrl && <li><a href={facebookUrl} rel="noopener" target="_blank">Facebook</a></li>}
        </ul>
      </div>
    </div>

    {/* Wordmark a tutta larghezza: SVG con textLength, così riempie esattamente il contenitore
        da bordo a bordo su ogni schermo e con qualsiasi font di sistema. */}
    <svg class="wordmark" viewBox="0 0 1000 104" aria-hidden="true" focusable="false">
      <text x="0" y="100" textLength="1000" lengthAdjust="spacingAndGlyphs">FRENZ JEWELZ</text>
    </svg>

    <div class="footer__bottom">
      <span>
        © {year} Frenz Jewelz
        {legalName && <> · {legalName}</>}
        {legalAddress && <> · {legalAddress}</>}
        {vatNumber && <> · P.IVA {vatNumber}</>}
      </span>
      <a href="https://www.ctrlstudio.it" rel="noopener" target="_blank">Developed by Ctrl Studio</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--grey-900);
    padding-top: clamp(3rem, 8vw, 6rem);
    margin-top: clamp(4rem, 10vw, 8rem);
    overflow: hidden;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .footer a,
  .footer__link {
    color: var(--grey-300);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .footer__link {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .footer a:hover,
  .footer__link:hover {
    color: var(--white);
  }

  .wordmark {
    display: block;
    width: 100%;
    height: auto;
    margin: clamp(3rem, 8vw, 6rem) 0 1.5rem;
    overflow: visible;
  }

  .wordmark text {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 136px;
    fill: var(--white);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--grey-900);
    font-size: 0.8125rem;
    color: var(--grey-500);
  }

  .footer__bottom a {
    font-size: inherit;
    color: var(--grey-500);
  }
</style>
