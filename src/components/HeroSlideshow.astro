---
import SanityImage from './SanityImage.astro'
import type {SanityImage as Img} from '../lib/types'

interface Props {
  images: Img[]
  /** Millisecondi tra una foto e l'altra. */
  interval?: number
}
const {images, interval = 4500} = Astro.props
---

{/* Slideshow a tutto schermo senza testo. Dissolvenza incrociata, si ferma con prefers-reduced-motion. */}
<section class="hero" aria-roledescription="slideshow" aria-label="Foto FRENZ" data-slideshow data-interval={interval}>
  {
    images.map((img, i) => (
      <div class="hero__slide" data-active={i === 0} aria-hidden={i !== 0}>
        <SanityImage image={img} aspect={16 / 9} sizes="100vw" widths={[640, 960, 1280, 1600, 2000]} priority={i === 0} />
      </div>
    ))
  }
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.hero__slide')]
    if (slides.length < 2 || reduce) return

    let current = 0
    let timer: number | undefined

    const show = (next: number) => {
      slides[current].dataset.active = 'false'
      slides[current].setAttribute('aria-hidden', 'true')
      slides[next].dataset.active = 'true'
      slides[next].setAttribute('aria-hidden', 'false')
      current = next
    }

    const start = () => {
      stop()
      timer = window.setInterval(() => show((current + 1) % slides.length), Number(root.dataset.interval))
    }
    const stop = () => window.clearInterval(timer)

    root.addEventListener('pointerenter', stop)
    root.addEventListener('pointerleave', start)
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()))
    start()
  })
</script>

<style>
  .hero {
    position: relative;
    height: min(88vh, 960px);
    min-height: 420px;
    background: var(--grey-900);
    overflow: hidden;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s var(--ease);
  }

  .hero__slide[data-active='true'] {
    opacity: 1;
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }
</style>
