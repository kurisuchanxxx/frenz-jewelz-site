---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductCard from '../components/ProductCard.astro'
import SanityImage from '../components/SanityImage.astro'
import {sanity} from '../lib/sanity'
import {FEATURED_PRODUCTS_QUERY, SETTINGS_QUERY} from '../lib/queries'
import type {ProductCard as Card, SiteSettings} from '../lib/types'

// Fase 1: hero + prodotti in evidenza. Lookbook e collab arrivano in fase 2.
const [settings, featured] = await Promise.all([
  sanity.fetch<SiteSettings | null>(SETTINGS_QUERY),
  sanity.fetch<Card[]>(FEATURED_PRODUCTS_QUERY),
])
---

<BaseLayout>
  <section class="hero">
    {
      settings?.heroImage && (
        <SanityImage image={settings.heroImage} aspect={16 / 9} sizes="100vw" priority class="hero__img" />
      )
    }
    <div class="container hero__text">
      <h1>{settings?.heroHeadline ?? 'Frenz Jewelz'}</h1>
      {settings?.heroSubline && <p>{settings.heroSubline}</p>}
      <a href="/shop" class="btn btn--solid">Vai allo shop</a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="container featured">
        <h2>In evidenza</h2>
        <div class="product-grid">
          {featured.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(85vh, 900px);
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.85), rgb(0 0 0 / 0) 60%);
  }

  .hero__text {
    position: relative;
    z-index: 1;
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  .hero__text h1 {
    max-width: 12ch;
    margin-bottom: 1rem;
  }

  .hero__text p {
    max-width: 40ch;
    color: var(--grey-100);
    font-size: 1.125rem;
  }

  .featured {
    padding-top: clamp(3rem, 8vw, 6rem);
  }

  .featured h2 {
    margin-bottom: 2rem;
  }
</style>
