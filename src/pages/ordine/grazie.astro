---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {getStripe} from '../../lib/stripe'
import {formatPrice} from '../../lib/money'

// Ritorno da Stripe. La sessione serve solo per mostrare il riepilogo:
// l'ordine vero lo scrive il webhook.
const sessionId = Astro.url.searchParams.get('session_id')
let summary: {email?: string; total?: number; paid: boolean} | null = null
// Evento "purchase" per Google Analytics (lo invia il browser, solo con consenso). Importi in euro.
let purchase: Record<string, unknown> | null = null
if (sessionId) {
  try {
    const s = await getStripe().checkout.sessions.retrieve(sessionId, {expand: ['line_items.data.price.product']})
    summary = {email: s.customer_details?.email ?? undefined, total: s.amount_total ?? undefined, paid: s.payment_status === 'paid'}
    if (summary.paid) {
      const shipping = s.total_details?.amount_shipping ?? 0
      const discount = s.total_details?.amount_discount ?? 0
      purchase = {
        transaction_id: s.id,
        currency: 'EUR',
        // GA4: value = merce al netto degli sconti, spedizione a parte.
        value: ((s.amount_subtotal ?? 0) - discount) / 100,
        shipping: shipping / 100,
        items: (s.line_items?.data ?? []).map((li) => {
          const product = li.price?.product
          const sanityId = typeof product === 'object' && product && !product.deleted ? product.metadata.sanityId : undefined
          return {
            item_id: sanityId ?? li.price?.id,
            item_name: li.description ?? '',
            price: (li.price?.unit_amount ?? 0) / 100,
            quantity: li.quantity ?? 1,
          }
        }),
      }
    }
  } catch {
    summary = null
  }
}
---

<BaseLayout title="Ordine completato" noindex>
  <section class="container thanks" data-ga-purchase={purchase ? JSON.stringify(purchase) : undefined}>
    <p class="eyebrow">Ordine completato</p>
    <h1>Grazie.</h1>
    {
      summary?.paid ? (
        <p>
          Pagamento ricevuto{summary.total ? `: ${formatPrice(summary.total)}` : ''}.
          {summary.email && <> Ti abbiamo mandato la conferma a <strong>{summary.email}</strong>.</>}
          Ti scriviamo di nuovo quando il pacco parte, con il tracking.
        </p>
      ) : (
        <p>Stiamo registrando il tuo ordine. Se non ricevi la conferma via email entro qualche minuto, scrivici.</p>
      )
    }
    <a href="/shop" class="btn">Torna allo shop</a>
  </section>
</BaseLayout>

<script>
  import {cart} from '../../lib/cart'
  import {trackPurchase} from '../../lib/analytics'

  cart.clear()

  const raw = document.querySelector<HTMLElement>('[data-ga-purchase]')?.dataset.gaPurchase
  if (raw) trackPurchase(JSON.parse(raw))
</script>

<style>
  .thanks {
    max-width: 640px;
    padding-block: clamp(4rem, 12vw, 10rem);
  }

  .thanks h1 {
    margin: 0.5rem 0 1.5rem;
  }

  .thanks p {
    color: var(--grey-100);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
</style>
